generator Client {
  provider = "prisma-client"
  output = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Costumer {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  name String
  email String @unique
  imageUrl String? @map("image_url")

  @@map("costumers")
}